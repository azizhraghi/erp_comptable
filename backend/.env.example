# Adresse du projet Supabase et clé publishable (jamais la service_role ici).
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_remplacer_par_votre_cle

# Secret exclusivement côté serveur. Ne pas préfixer par VITE_.
MISTRAL_API_KEY=remplacer_par_votre_cle_mistral
MISTRAL_MODEL=mistral-small-latest

# Adresses autorisées à appeler l'API pendant le développement.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
